rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // User profile documents and subcollections (coreTasks, secondaryTasks, todos, dailyThoughts)
    match /users/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId);

      match /{allPaths=**} {
        allow read, write: if isValidId(userId) && isOwner(userId);
      }
    }

    // Username lookup for uniqueness
    match /usernames/{usernameDoc} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.resource.data.uid == request.auth.uid || resource.data.uid == request.auth.uid);
    }

    // Planner data parent document and all subcollections (categories, goals, phases, history, etc.)
    match /planners/{userId} {
      allow read, write: if isValidId(userId) && isOwner(userId)
                         && (request.resource == null || request.resource.size() < 200000);

      match /{allSubcollections=**} {
        allow read, write: if isValidId(userId) && isOwner(userId)
                           && (request.resource == null || request.resource.size() < 200000);
      }
    }
  }
}
