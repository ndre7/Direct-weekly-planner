    setDraft(prev => prev ? ({
      ...prev,
      phases: (prev.phases || []).map(p => p.phase_number === pNum ? { ...p, ...patch } : p)
    }) : prev);

  const updateWeek = (pNum: number, wNum: number, patch: Partial<GoalWeek>) =>
    setDraft(prev => prev ? ({
      ...prev,
      phases: (prev.phases || []).map(p => p.phase_number !== pNum ? p : ({
        ...p,
        weeks: (p.weeks || []).map(w => w.week_number === wNum ? { ...w, ...patch } : w)
      }))
