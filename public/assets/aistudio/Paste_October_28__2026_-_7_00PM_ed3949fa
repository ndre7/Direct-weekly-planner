interface GoalEditorModalProps {
  goal: Goal | null;
  open: boolean;
  categories: Category[];
  lang?: 'fa' | 'en';
  onClose: () => void;
  onSave: (edited: Goal) => void;
}

const COLOR_CHOICES = [
  { name: 'نیلی', value: 'bg-indigo-100 border-indigo-300 text-indigo-900' },
  { name: 'زمردی', value: 'bg-emerald-100 border-emerald-300 text-emerald-900' },
