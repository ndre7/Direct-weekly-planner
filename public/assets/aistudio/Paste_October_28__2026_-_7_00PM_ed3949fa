  const updateTask = (pNum: number, wNum: number | null, taskId: string, patch: Partial<GoalPhaseTask>) =>
    setDraft(prev => prev ? ({
      ...prev,
      phases: (prev.phases || []).map(p => {
        if (p.phase_number !== pNum) return p;
        if (wNum === null) {
          return { ...p, tasks: p.tasks.map(tk => tk.id === taskId ? { ...tk, ...patch } : tk) };
        }
        return {
          ...p,
          weeks: (p.weeks || []).map(w => w.week_number !== wNum ? w : ({
            ...w,
            tasks: w.tasks.map(tk => tk.id === taskId ? { ...tk, ...patch } : tk)
          }))
