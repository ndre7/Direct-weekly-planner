  const textVal = text || "{}";
  const parsed = JSON.parse(textVal.trim());

  // T161-F: coverage validation — weeks of phases must cover ai_estimated_weeks
  const expectedWeeks = Number(parsed.ai_estimated_weeks) || Number(totalWeeks) || 0;
  const countCovered = (obj: any) => (obj.phases || []).reduce((s: number, ph: any) => s + (((ph.weeks || []).length) || 0), 0);
  let coveredWeeks = countCovered(parsed);
  let coverageComplete = expectedWeeks > 0 && coveredWeeks >= expectedWeeks;

  if (!coverageComplete && expectedWeeks > 0) {
    try {
      const maxWeekSoFar = (parsed.phases || []).reduce((m: number, ph: any) => Math.max(m, ...((ph.weeks || []).map((w: any) => Number(w.week_number) || 0))), 0);
      const contPrompt = `ادامهٔ نقشه راه برای هدف "${title}" را تولید کن. هفته‌های ۱ تا ${maxWeekSoFar} قبلاً تولید شده‌اند. فقط هفته‌های ${maxWeekSoFar + 1} تا ${expectedWeeks} را در همان قالب JSON قبلی (آرایهٔ phases با weeks و tasks) تولید کن؛ هیچ متن اضافه و هیچ توضیحی ننویس، فقط JSON.`;
      const contResult = await callGeminiWithFallback({
        prompt: contPrompt,
        preferredModels: GOAL_ANALYSIS_MODELS,
        getConfigForModel: getConfigForGoalAnalysis,
        maxOutputTokens: 32768,
        userKeysHeader,
        customKeys,
      });
      const contParsed = JSON.parse(contResult.text.trim());
      const contPhases: any[] = contParsed.phases || [];
      const existingByNumber = new Map<number, any>();
      (parsed.phases || []).forEach((ph: any) => existingByNumber.set(Number(ph.phase_number), ph));
      for (const cph of contPhases) {
        const num = Number(cph.phase_number);
        const target = existingByNumber.get(num);
        if (target) {
          const seenWeeks = new Set((target.weeks || []).map((w: any) => Number(w.week_number)));
          const newWeeks = (cph.weeks || []).filter((w: any) => !seenWeeks.has(Number(w.week_number)));
          target.weeks = [...(target.weeks || []), ...newWeeks];
          target.tasks = [...(target.tasks || []), ...((cph.tasks || []))];
        } else {
          parsed.phases = parsed.phases || [];
          parsed.phases.push(cph);
          existingByNumber.set(num, cph);
        }
      }
      coveredWeeks = countCovered(parsed);
      coverageComplete = coveredWeeks >= expectedWeeks;
    } catch (contErr: any) {
      console.warn("[AI Roadmap Continuation] failed:", contErr?.message || contErr);
    }
  }

  return res.json({
    success: true,
    ...parsed,
    coverage: {
      complete: coverageComplete,
      expectedWeeks,
      coveredWeeks,
      ...(coverageComplete ? {} : { warning: "نقشه راه کامل تولید نشد؛ هفته‌های پوشش‌داده‌شده کمتر از تخمین هوش مصنوعی است." })
    }
  });

